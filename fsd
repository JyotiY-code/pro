fi

echo ""
echo "Repository created at: $(pwd)"

if [ "$1" = "--publish" ]; then
  echo "Publishing to GitHub as a PUBLIC repo..."
  gh repo create "$REPO" --public --source=. --remote=origin --push
else
  echo "To publish later, run this inside the '$REPO' folder:"
  echo "  gh repo create $REPO --public --source=. --remote=origin --push"
fi
