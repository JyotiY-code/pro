#!/usr/bin/env bash
# setup-repo.sh
# Creates a Git repository with all the web projects in one go.
#
# Usage:
#   bash setup-repo.sh              -> creates ./my-web-projects and makes the first commit
#   bash setup-repo.sh --publish    -> same, and also creates a PUBLIC GitHub repo (needs `gh` login)

set -e

REPO="my-web-projects"

if [ -e "$REPO" ]; then
  echo "Folder '$REPO' already exists. Rename or delete it, then run again."
  exit 1
fi

mkdir -p "$REPO"
cd "$REPO"

mkdir -p 01-bootstrap-carousel 02-bootstrap-website 03-shopping-list 04-cart-app 05-translation-app 06-registration-form 07-express-server

# ---------------------------------------------------------------- README
cat > README.md <<'EOF'
# My Web Projects

A collection of small front-end and Node.js practice projects.

| Folder | Project | Tech |
|--------|---------|------|
| 01-bootstrap-carousel | Bootstrap carousel with CSS3 animation | Bootstrap 5 |
| 02-bootstrap-website | Responsive website with navbar and cards | Bootstrap 5 |
| 03-shopping-list | Shopping list (add / remove items) | AngularJS |
| 04-cart-app | Shopping cart with running total | AngularJS |
| 05-translation-app | English to Hindi word translator | AngularJS |
| 06-registration-form | Registration form with validation | AngularJS |
| 07-express-server | Basic Express server | Node.js + Express |

## How to run

HTML projects: open the `index.html` file in your browser (or use the VS Code "Live Server" extension).

Express server:

```bash
cd 07-express-server
npm install
npm start
```

Then open http://localhost:3000
EOF

