# ---------------------------------------------------------------- 03 Shopping list
cat > 03-shopping-list/index.html <<'EOF'
<!DOCTYPE html>
<html ng-app="shoppingApp">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping List</title>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>

<body ng-controller="shoppingController">

    <h2>Shopping List</h2>

    <input type="text" ng-model="newItem" placeholder="Enter item">

    <button ng-click="addItem()">Add Item</button>

    <ul>
        <li ng-repeat="item in shoppingItems">
            {{item}}
            <button ng-click="removeItem($index)">
                Remove
            </button>
        </li>
    </ul>

    <script>
        var app = angular.module("shoppingApp", []);

        app.controller("shoppingController", function ($scope) {

            $scope.shoppingItems = [];

            $scope.addItem = function () {
                if ($scope.newItem) {
                    $scope.shoppingItems.push($scope.newItem);
                    $scope.newItem = "";
                }
            };

            $scope.removeItem = function (index) {
                $scope.shoppingItems.splice(index, 1);
            };

        });
    </script>

</body>
</html>
EOF

# ---------------------------------------------------------------- 04 Cart
cat > 04-cart-app/index.html <<'EOF'
<!DOCTYPE html>
<html ng-app="cartApp">
<head>
    <meta charset="UTF-8">
    <title>AngularJS Cart Application</title>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>

<body ng-controller="cartController">

    <h2>Shopping Cart Application</h2>
    <h3>Products</h3>

    <button ng-click="addToCart('Laptop',50000)">
        Laptop - ₹50000
    </button>

    <button ng-click="addToCart('Mobile',20000)">
        Mobile - ₹20000
    </button>

    <button ng-click="addToCart('Headphones',3000)">
        Headphones - ₹3000
    </button>

    <h3>Cart Items</h3>

    <ul>
        <li ng-repeat="item in cart">
            {{item.name}} - ₹{{item.price}}
        </li>
    </ul>

    <h3>Total Amount: ₹{{total}}</h3>

    <script>
        var app = angular.module("cartApp", []);

        app.controller("cartController", function ($scope) {

            $scope.cart = [];
            $scope.total = 0;

            $scope.addToCart = function (name, price) {
                $scope.cart.push({
                    name: name,
                    price: price
                });

                $scope.total += price;
            };

        });
    </script>

</body>
</html>
EOF

# ---------------------------------------------------------------- 05 Translation
cat > 05-translation-app/index.html <<'EOF'
<!DOCTYPE html>
<html ng-app="translationApp">
<head>
    <meta charset="UTF-8">
    <title>AngularJS Translation Application</title>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>

<body ng-controller="translationController">

    <h2>Translation Application</h2>

    <input type="text" ng-model="word" placeholder="Enter English Word">

    <button ng-click="translate()">Translate</button>

    <h3>Translation: {{translatedWord}}</h3>

    <script>
        var app = angular.module("translationApp", []);

        app.controller("translationController", function ($scope) {

            var dictionary = {
                "hello": "नमस्ते",
                "good": "अच्छा",
                "book": "किताब",
                "water": "पानी",
                "computer": "कंप्यूटर"
            };

            $scope.translate = function () {

                var input = ($scope.word || "").toLowerCase();

                if (dictionary[input]) {
                    $scope.translatedWord = dictionary[input];
                } else {
                    $scope.translatedWord = "Translation Not Found";
                }

            };

        });
    </script>

</body>
</html>
EOF

