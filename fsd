cat > 06-registration-form/index.html <<'EOF'
<!DOCTYPE html>
<html ng-app="formApp">
<head>
    <meta charset="UTF-8">
    <title>AngularJS Form Application</title>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>

<body ng-controller="formController">

    <h2>Registration Form</h2>

    <form name="myForm" novalidate>

        Name:
        <input type="text" name="name"
               ng-model="name"
               ng-focus="focusMsg='Name field selected'"
               ng-blur="blurMsg='Name field left'"
               required>

        <br><br>

        Email:
        <input type="email" name="email"
               ng-model="email" required>

        <br><br>

        Course:
        <select ng-model="course"
                ng-change="changeMsg='Course Changed'">
            <option value="">Select Course</option>
            <option>MCA</option>
            <option>MSc CS</option>
            <option>BCA</option>
        </select>

        <br><br>

        <button type="button" ng-click="submitForm()">
            Submit
        </button>

    </form>

    <p>{{focusMsg}}</p>
    <p>{{blurMsg}}</p>
    <p>{{changeMsg}}</p>

    <h3 ng-mouseover="mouseMsg='Mouse Over Event Triggered'">
        Move Mouse Here
    </h3>

    <p>{{mouseMsg}}</p>

    <p>Name: {{name}}</p>
    <p>Email: {{email}}</p>

    <script>
        var app = angular.module("formApp", []);

        app.controller("formController", function ($scope) {

            $scope.submitForm = function () {

                if ($scope.myForm.$valid) {
                    alert("Form Submitted Successfully");
                } else {
                    alert("Please Fill All Required Fields Correctly");
                }

            };

        });
    </script>

</body>
</html>
EOF

